{
  "manifest_version": 3,
  "name": "GitHub bot slash-command autocomplete",
  "version": "2.2.3",
  "description": "Autocomplete for bot slash commands in GitHub comment boxes. Finds commands on the pages you visit and lists them on an editable options page. Runs only on github.com; no network access.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Slash commands"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["content/content.css"],
      "js": ["content/state.js", "shared/matching.js", "content/scan.js", "content/menu.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
